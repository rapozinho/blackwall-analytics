# Configuracao do backend fora do Docker (`dev.ps1` ou uvicorn na mao).
#
# Com `docker compose up` este arquivo NAO e usado: o compose passa tudo por
# variavel de ambiente e o banco e o proprio container `sqlserver`.
#
# Os valores abaixo apontam para a stack de demonstracao — `PORTA_SQL` do
# docker-compose publica o SQL Server em 127.0.0.1:11433. Sao credenciais de
# ambiente local; num servidor de verdade, use um login somente leitura
# dedicado e mantenha este arquivo fora do repositorio.
SERVER=127.0.0.1,11433
DB_USER=blackwall_ro
DB_PASSWORD=BlackWall!Ro2026
ODBC_DRIVER=ODBC Driver 18 for SQL Server

# TLS ate o banco. O certificado do container e autoassinado, entao a VALIDACAO
# fica desligada — a criptografia continua ligada. Em producao: certificado
# valido e DB_TRUST_SERVER_CERTIFICATE=no.
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes

# Um database por base (whitelist no codigo).
DATABASE_ZEPHYR=dw_zephyr
DATABASE_QUASAR=dw_quasar
DATABASE_LUMEN=dw_lumen
DATABASE_KESTREL=dw_kestrel

# CORS: origem do frontend (dev = Vite).
CORS_ORIGINS=http://localhost:5173

# Auth (stub). Em producao: integrar SSO (Microsoft Entra) e remover o bypass.
AUTH_DISABLED=true
