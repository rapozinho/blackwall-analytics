# Conexao SQL Server — USE UM USUARIO SOMENTE LEITURA dedicado.
SERVER=seu-servidor-sql
DB_USER=usuario_readonly
DB_PASSWORD=troque-me
ODBC_DRIVER=ODBC Driver 17 for SQL Server

# Um database por base (whitelist no codigo).
DATABASE_F12=nome_db_f12
DATABASE_LUVA=nome_db_luva
DATABASE_BRASILBET=nome_db_brasilbet
DATABASE_GALERABET=nome_db_galerabet

# CORS: origem do frontend (dev = Vite).
CORS_ORIGINS=http://localhost:5173

# Auth (stub). Em producao: integrar SSO (Microsoft Entra) e remover o bypass.
AUTH_DISABLED=true
